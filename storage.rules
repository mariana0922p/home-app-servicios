rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerProfessional(uid) {
      return signedIn()
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.role == 'trabajador';
    }

    function isOwnerClient(uid) {
      return signedIn()
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.role == 'cliente';
    }

    match /professional-documents/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isOwnerProfessional(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png',
          'application/octet-stream'
        ];
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /request-attachments/{clientUid}/{requestId}/{fileName} {
      allow create, update: if isOwnerClient(clientUid)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == clientUid)
        || (signedIn()
          && firestore.exists(/databases/(default)/documents/requests/$(requestId))
          && firestore.get(/databases/(default)/documents/requests/$(requestId)).data.clientId == clientUid
          && firestore.get(/databases/(default)/documents/requests/$(requestId)).data.workerId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == clientUid);
    }
  }
}
